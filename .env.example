# Copy to .env only when you need to override defaults.
# The process already starts on safe + LLM off without this file.

# Cumulative profiles: safe, scan, active-lab, full.
AUTORT_CAPABILITY_PROFILE=safe

# strict requires AUTOREDTEAM_API_KEY (MCP_API_KEY is also accepted).
# disabled works only when AUTOREDTEAM_ENV=test or pytest is running.
AUTOREDTEAM_AUTH_MODE=strict
AUTOREDTEAM_API_KEY=

# LLM stays off unless you set a provider. none is the default.
AUTORT_LLM_PROVIDER=none
# AUTORT_LLM_MODEL=
# AUTORT_LLM_API_KEY=
# AUTORT_LLM_BASE_URL=

# Optional: encrypt stored secrets.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REDTEAM_MASTER_KEY=
